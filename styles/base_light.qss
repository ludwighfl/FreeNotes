/* ── Farbpalette (LIGHT) ─────────────────────
   App-BG:       #f5f5f5
   Panels:       #e8e8e8
   Cards:        #ffffff
   Hover:        #e0e0e0
   Active/Blau:  #3B7BF5
   Text primär:  #1a1a1a
   Text sekundär:#666666
   Divider:      #d0d0d0
─────────────────────────────────────────────── */

/* --- Global --- */
QWidget {
    background-color: #f5f5f5;
    color: #1a1a1a;
    font-family: "Roboto", "Segoe UI", sans-serif;
}

/* --- Main Window --- */
QMainWindow {
    background-color: #f5f5f5;
}

/* --- Stacked Widget --- */
QStackedWidget {
    background-color: #f5f5f5;
}

/* ============================================================
   MANAGER VIEW
   ============================================================ */

#managerView {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fafafa, stop:1 #ebebeb);
}

#managerSidebar {
    background-color: rgba(240, 240, 240, 160);
    border-right: 1px solid rgba(0, 0, 0, 15);
}

#managerContent {
    background-color: transparent;
}

#managerTitleLabel {
    color: #1a1a1a;
}

#managerEmptyTitle {
    color: #888888;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
}

#managerEmptyDesc {
    color: #333333;
    font-size: 13px;
    background: transparent;
}

QLabel#colorPickerTitle {
    color: #1a1a1a;
    background: transparent;
}
QLabel#colorPickerLabel {
    color: #1a1a1a;
    background: transparent;
}

#sidebarScroll,
#sidebarContainer {
    background: transparent;
    border: none;
}

#sidebarIcon {
    background: transparent;
}

#sidebarItemText {
    color: #1a1a1a;
    font-size: 13px;
    background: transparent;
}

QWidget#sidebarItem {
    background: transparent;
    border-radius: 6px;
}
QWidget#sidebarItem:hover {
    background: rgba(0, 0, 0, 10);
}
QWidget#sidebarItem[active="true"] {
    background: #3B7BF5;
}
QWidget#sidebarItem[active="true"] #sidebarItemText {
    color: #ffffff;
}

#managerScroll {
    background-color: transparent;
    border: none;
}

#folderList {
    background-color: rgba(240, 240, 240, 160);
    border: none;
    outline: none;
}

#folderList::item {
    padding: 6px 10px;
    border-radius: 4px;
    color: #1a1a1a;
}

#folderList::item:hover {
    background-color: rgba(0, 0, 0, 8);
}

#folderList::item:selected {
    background-color: #3B7BF5;
    color: #ffffff;
}

/* Create / Import button */
#createBtn {
    background-color: rgba(59, 123, 245, 210);
    color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 10);
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: bold;
}

#createBtn:hover {
    background-color: rgba(74, 138, 255, 230);
}

#createBtn:pressed {
    background-color: rgba(46, 107, 224, 240);
}

#createBtn::menu-indicator {
    width: 0;
    height: 0;
}

/* PDF Cards */
#pdfCard {
    background-color: rgba(255, 255, 255, 160);
    border: 1px solid rgba(0, 0, 0, 12);
    border-radius: 12px;
}

#pdfCard:hover {
    border-color: rgba(0, 0, 0, 25);
    background-color: rgba(255, 255, 255, 220);
}

#pdfCard[selected="true"] {
    border: 2px solid #3B7BF5;
    background-color: rgba(59, 123, 245, 25);
}

#pdfCardThumb {
    background-color: rgba(0, 0, 0, 6);
    border-radius: 8px;
}

/* Manager separator */
#managerSeparator {
    color: rgba(0, 0, 0, 15);
}

/* Settings & Multi-Select Buttons */
QToolButton#settingsBtn,
QToolButton#multiSelectBtn {
    background: rgba(0, 0, 0, 8);
    border: 1px solid rgba(0, 0, 0, 12);
    border-radius: 8px;
}
QToolButton#settingsBtn:hover,
QToolButton#multiSelectBtn:hover {
    background: rgba(0, 0, 0, 16);
    border-color: rgba(0, 0, 0, 25);
}
QToolButton#settingsBtn::menu-indicator {
    width: 0; height: 0;
}

/* Settings Menu */
QMenu#settingsMenu {
    background-color: rgba(250, 250, 250, 225);
    border: 1px solid rgba(0, 0, 0, 15);
    border-radius: 8px;
    padding: 6px 4px;
    color: #333333;
    font-size: 13px;
}
QMenu#settingsMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
    background-color: transparent;
    margin: 1px 2px;
}
QMenu#settingsMenu::item:selected {
    background-color: rgba(59, 123, 245, 200);
    color: #ffffff;
}
QMenu#settingsMenu::separator {
    height: 1px;
    background-color: rgba(0, 0, 0, 15);
    margin: 4px 6px;
}

/* ============================================================
   NEW NOTE DIALOG
   ============================================================ */

QDialog#newNoteDialog { background: transparent; }
QLabel#presetTitleLabel { color: #1a1a1a; }
QLabel#newNoteNameLabel { color: #1a1a1a; font-size: 14px; }
QLineEdit#newNoteNameInput { 
    background: #ffffff; 
    border: 1px solid #d0d0d0; 
    border-radius: 4px; 
    padding: 8px; 
    color: #1a1a1a; 
    font-size: 14px; 
}
QLineEdit#newNoteNameInput:focus { border: 1px solid #3B7BF5; }

QFrame#presetButton { background: #ffffff; border: 2px solid transparent; border-radius: 8px; }
QFrame#presetButton:hover { background: #f0f0f0; border: 2px solid transparent; }
QFrame#presetButton[selected="true"] { background: #f0f0f0; border: 2px solid #3B7BF5; }

QPushButton#newNoteCancelBtn { background: #e0e0e0; color: #333333; border: none; border-radius: 4px; font-weight: bold; }
QPushButton#newNoteCancelBtn:hover { background: #d0d0d0; }

QPushButton#newNoteOkBtn { background: #3B7BF5; color: #ffffff; border: none; border-radius: 4px; font-weight: bold; }
QPushButton#newNoteOkBtn:hover { background: #5090FF; }
QPushButton#newNoteOkBtn:disabled { background: #e0e0e0; color: #a0a0a0; }

QLabel#newNoteOrientationLabel { color: #1a1a1a; font-size: 14px; }
QPushButton#newNotePortraitBtn, QPushButton#newNoteLandscapeBtn {
    background: #ffffff;
    color: #1a1a1a;
    border: 2px solid transparent;
    border-radius: 6px;
    font-weight: bold;
}
QPushButton#newNotePortraitBtn:hover, QPushButton#newNoteLandscapeBtn:hover {
    background: #f0f0f0;
}
QPushButton#newNotePortraitBtn:checked, QPushButton#newNoteLandscapeBtn:checked {
    background: #f0f0f0;
    border: 2px solid #3B7BF5;
}

/* ============================================================
   TEXTBOX OPTIONS POPUP
   ============================================================ */

QToolButton#popupBtn, QToolButton#popupDeleteBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
}
QToolButton#popupBtn:hover {
    background: #e0e0e0;
}
QToolButton#popupDeleteBtn:hover {
    background: #ffe5e5;
}
QFrame#PopupSeparator {
    color: #d0d0d0;
}

/* ============================================================
   TOOLBAR MENUS
   ============================================================ */

QMenu#eraserModeMenu, QMenu#selectionModeMenu, QMenu#shapeMenu {
    background-color: rgba(250, 250, 250, 225);
    border: 1px solid rgba(0, 0, 0, 15);
    border-radius: 8px;
    padding: 6px 4px;
    font-family: "Roboto", "Segoe UI", sans-serif;
    font-size: 13px;
}
QMenu#eraserModeMenu::item, QMenu#selectionModeMenu::item, QMenu#shapeMenu::item {
    padding: 6px 32px 6px 12px;
    color: #333333;
    border-radius: 4px;
    background-color: transparent;
    margin: 1px 2px;
}
QMenu#eraserModeMenu::item:selected, QMenu#selectionModeMenu::item:selected, QMenu#shapeMenu::item:selected {
    background-color: rgba(59, 123, 245, 200);
    color: #ffffff;
}
QMenu#eraserModeMenu::separator, QMenu#selectionModeMenu::separator, QMenu#shapeMenu::separator {
    height: 1px;
    background-color: rgba(0, 0, 0, 15);
    margin: 4px 6px;
}

/* ============================================================
   VIEWER WINDOW
   ============================================================ */

#viewerWindow {
    background-color: #f5f5f5;
}

#viewerTopBar {
    background-color: #f5f5f5;
}

#viewerHeader {
    background-color: #f5f5f5;
}

/* Back button */
#backBtn {
    background-color: transparent;
    border: none;
    color: #1a1a1a;
    border-radius: 6px;
}

#backBtn:hover {
    background-color: #e0e0e0;
}

/* Page input */
#pageInput {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    color: #1a1a1a;
    padding: 2px 4px;
}

#pageInput:focus {
    border-color: #3B7BF5;
}

/* Separators */
#viewerSeparator {
    color: #d0d0d0;
    max-height: 1px;
}

#viewerSidebarSep {
    color: #d0d0d0;
    max-width: 1px;
}

/* ============================================================
   SIDEBAR WIDGET
   ============================================================ */

#sidebarWidget {
    background-color: #e8e8e8;
    border: none;
}

#sidebarColumn {
    background-color: #e8e8e8;
}

#pageCounterBar {
    background-color: #e8e8e8;
    border-bottom: 1px solid #d0d0d0;
}

#thumbnailCard {
    background-color: #e8e8e8;
    border: 2px solid transparent;
    border-radius: 4px;
}

#thumbnailCard[active="true"] {
    border: 2px solid #3B7BF5;
    background: #e0e0e0;
}

/* ============================================================
   PAGE VIEW (QGraphicsView)
   ============================================================ */

QGraphicsView {
    background-color: #e0e0e0;
    border: none;
}

/* ============================================================
   SCROLLBARS – slim, rounded, 8px wide
   ============================================================ */

QScrollBar:vertical {
    background-color: #e8e8e8;
    width: 8px;
    margin: 0;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #e8e8e8;
    height: 8px;
    margin: 0;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ============================================================
   TOOLTIPS
   ============================================================ */

QToolTip {
    background-color: rgba(250, 250, 250, 225);
    color: #333333;
    border: 1px solid rgba(0, 0, 0, 15);
    padding: 6px 10px;
    border-radius: 6px;
    font-family: "Roboto", "Segoe UI", sans-serif;
    font-size: 12px;
}

/* ============================================================
   LABELS (no extra background)
   ============================================================ */

QLabel {
    background-color: transparent;
}

/* ============================================================
   LINE EDITS
   ============================================================ */

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    color: #1a1a1a;
    padding: 4px 8px;
    selection-background-color: #3B7BF5;
}

QLineEdit:focus {
    border-color: #3B7BF5;
}

/* ============================================================
   PUSH BUTTONS (generic)
   ============================================================ */

QPushButton {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #e8e8e8;
}

QPushButton:pressed {
    background-color: #d0d0d0;
}

/* ============================================================
   COLOR PICKER POPUP HEADER BUTTONS
   ============================================================ */

QPushButton[class="picker-action"] {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: #e8e8e8;
    color: #666666;
    border: none;
}

QPushButton[class="picker-action"]:hover {
    background: #d0d0d0;
    color: #1a1a1a;
}

/* ============================================================
   SLIDERS (Color Picker)
   ============================================================ */

QSlider::groove:horizontal {
    height: 8px;
    border-radius: 4px;
    background: #d0d0d0;
}

QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -5px 0;
    border-radius: 9px;
    background: white;
    border: 2px solid rgba(0, 0, 0, 0.15);
}

QSlider::sub-page:horizontal {
    background: transparent;
}

/* ============================================================
   FRAMES (dividers)
   ============================================================ */

QFrame[frameShape="4"],  /* HLine */
QFrame[frameShape="5"] { /* VLine */
    color: #d0d0d0;
}

/* ============================================================
   SETTINGS VIEW
   ============================================================ */

QWidget#settingsView {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fafafa, stop:1 #ebebeb);
}

QWidget#settingsSidebar {
    background: rgba(240, 240, 240, 160);
    border-right: 1px solid rgba(0, 0, 0, 15);
}

QWidget#settingsHeader {
    background: transparent;
}

QFrame#settingsSeparator {
    border: none;
    background-color: rgba(0, 0, 0, 15);
    max-height: 1px;
    min-height: 1px;
}

QStackedWidget#settingsStack {
    background: transparent;
}

/* Settings Pages */
QWidget#settingsPage {
    background: transparent;
}
QLabel#settingsTitleLabel { color: #1a1a1a; }
QLabel#settingsPlaceholder { color: #888888; }

/* Sidebar Buttons */
QToolButton#settingsSidebarBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #1a1a1a;
    font-size: 13px;
    padding: 4px 8px;
    text-align: left;
}
QToolButton#settingsSidebarBtn:hover {
    background: rgba(0, 0, 0, 10);
}
QToolButton#settingsSidebarBtn:checked {
    background: rgba(59, 123, 245, 180);
    border: 1px solid rgba(0, 0, 0, 10);
    color: #ffffff;
}

/* Mode / Lang Buttons */
QToolButton#modeBtn,
QToolButton#langBtn {
    background: rgba(0, 0, 0, 8);
    border: 1px solid rgba(0, 0, 0, 12);
    border-radius: 6px;
    color: #1a1a1a;
    font-size: 13px;
    padding: 6px 12px;
}
QToolButton#modeBtn:checked,
QToolButton#langBtn:checked {
    background: rgba(59, 123, 245, 180);
    border: 1px solid rgba(59, 123, 245, 200);
    color: #ffffff;
}
QToolButton#modeBtn:hover:!checked,
QToolButton#langBtn:hover:!checked {
    background: rgba(0, 0, 0, 12);
}

/* Action Buttons */
QPushButton#settingsActionBtn {
    background: rgba(0, 0, 0, 8);
    border: 1px solid rgba(0, 0, 0, 12);
    border-radius: 6px;
    color: #1a1a1a;
    padding: 8px 16px;
    font-size: 13px;
}
QPushButton#settingsActionBtn:hover {
    background: rgba(0, 0, 0, 12);
    border-color: rgba(0, 0, 0, 20);
}

/* Settings Path Label */
QLabel#settingsPathLabel {
    background: rgba(0, 0, 0, 6);
    border: 1px solid rgba(0, 0, 0, 10);
    border-radius: 4px;
    color: #1a1a1a;
    font-size: 12px;
    padding: 8px;
}

/* Manager Search */
QLineEdit#managerSearch {
    background: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    color: #1a1a1a;
    font-size: 13px;
    padding: 4px 10px;
}
QLineEdit#managerSearch:focus {
    border-color: #3B7BF5;
}

/* ============================================================
   FIRST RUN DIALOG
   ============================================================ */

QDialog#firstRunDialog { background: transparent; }
QLabel#firstRunTitle { color: #1a1a1a; }
QLabel#firstRunDesc { color: #666666; font-size: 13px; }
QLabel#firstRunPathLabel {
    color: #333333; font-size: 12px;
    background: #e8e8e8; padding: 6px;
    border-radius: 4px;
}
QPushButton#browseBtn {
    background: #ffffff; color: #1a1a1a;
    border: 1px solid #d0d0d0; border-radius: 4px;
    padding: 6px 12px;
}
QPushButton#browseBtn:hover { background: #e8e8e8; }
QPushButton#primaryBtn {
    background: #3B7BF5; color: #ffffff;
    border: none; border-radius: 6px;
    font-size: 14px; font-weight: bold;
}
QPushButton#primaryBtn:hover { background: #5090FF; }

#pageBadge {
    background-color: rgba(240, 240, 240, 200);
    color: #1a1a1a;
    border-radius: 4px;
    padding: 2px 6px;
}

#managerFolderTitle {
    color: #1a1a1a;
}

#viewerTitleLabel {
    color: #1a1a1a;
}

#viewerExtLabel {
    color: #666666;
}

#viewerBreadcrumbLabel {
    color: #888888;
}

#editableTitleEditor {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #3B7BF5;
    border-radius: 4px;
    padding: 0 4px;
}

#settingsDangerTitle {
    color: #c92a2a;
}

#settingsDangerBtn {
    color: #c92a2a;
    border-color: #c92a2a;
}

#settingsDangerBtn:hover {
    background-color: rgba(201, 42, 42, 0.08);
}

/* ============================================================
   GLOBAL GLASSMORPHIC CONTEXT MENU (LIGHT)
   ============================================================ */
QMenu {
    background-color: rgba(250, 250, 250, 225);
    border: 1px solid rgba(0, 0, 0, 15);
    border-radius: 8px;
    padding: 6px 4px;
    font-family: "Roboto", "Segoe UI", sans-serif;
    font-size: 13px;
}
QMenu::item {
    padding: 6px 28px 6px 12px;
    color: #333333;
    border-radius: 4px;
    background-color: transparent;
    margin: 2px 2px;
}
QMenu::item:selected {
    background-color: rgba(59, 123, 245, 200);
    color: #ffffff;
}
QMenu::item:disabled {
    color: #b0b0b0;
}
QMenu::separator {
    height: 1px;
    background-color: rgba(0, 0, 0, 15);
    margin: 4px 6px;
}

/* ============================================================
   SEARCH BAR (LIGHT MODE)
   ============================================================ */
QLineEdit#searchInput {
    background-color: rgba(0, 0, 0, 10);
    border: 1px solid rgba(0, 0, 0, 15);
    border-radius: 6px;
    color: #333333;
    font-size: 13px;
    padding: 4px 8px;
    selection-background-color: #3B7BF5;
}
QLineEdit#searchInput:hover {
    background-color: rgba(0, 0, 0, 14);
    border-color: rgba(0, 0, 0, 22);
}
QLineEdit#searchInput:focus {
    border-color: #3B7BF5;
    background-color: rgba(0, 0, 0, 14);
}
QLabel#searchCount {
    color: #555555;
    font-size: 12px;
    background: transparent;
}
QToolButton#searchNavBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}
QToolButton#searchNavBtn:hover {
    background-color: rgba(0, 0, 0, 12);
    border-color: rgba(0, 0, 0, 18);
}
QToolButton#searchCloseBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}
QToolButton#searchCloseBtn:hover {
    background-color: rgba(239, 68, 68, 40);
    border-color: rgba(239, 68, 68, 60);
}
