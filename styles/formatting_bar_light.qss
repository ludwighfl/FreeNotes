/* ============================================================
   FLOATING FORMATTING BAR (LIGHT MODE - REDESIGNED FROM SCRATCH)
   ============================================================ */

QWidget#FormattingBar {
    background: transparent;
}

/* ── Individual Format & Alignment Buttons ── */
QToolButton#formatBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #444444;
    font-size: 13px;
    padding: 0px;
    min-width: 30px;
    min-height: 30px;
    max-width: 30px;
    max-height: 30px;
}

QToolButton#formatBtn:hover {
    background-color: rgba(0, 0, 0, 10);
    color: #000000;
}

QToolButton#formatBtn:checked {
    background-color: rgba(59, 123, 245, 30);
    border: 1px solid rgba(59, 123, 245, 60);
    color: #3B7BF5;
}

QToolButton#formatBtn:checked:hover {
    background-color: rgba(59, 123, 245, 45);
}

/* Specific text styles for B, I, U, S font rendering */
QToolButton#formatBtn[text="B"] { font-weight: bold; }
QToolButton#formatBtn[text="I"] { font-style: italic; }

/* ── Font Combo (Dropdown) ── */
QComboBox#fontCombo {
    background-color: rgba(0, 0, 0, 10);
    border: 1px solid rgba(0, 0, 0, 15);
    border-radius: 8px;
    color: #333333;
    padding: 0px 24px 0px 10px;
    font-size: 13px;
    min-width: 130px;
    max-width: 130px;
    min-height: 30px;
    max-height: 30px;
}

QComboBox#fontCombo:hover {
    background-color: rgba(0, 0, 0, 14);
    border-color: rgba(0, 0, 0, 22);
    color: #000000;
}

QComboBox#fontCombo[popupActive="true"] {
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    background-color: rgba(250, 250, 250, 224);
    border-bottom-color: transparent;
}

QComboBox#fontCombo::drop-down {
    width: 0px;
    height: 0px;
    border: none;
    background: transparent;
}

QComboBox#fontCombo::down-arrow {
    image: none;
    border: none;
    background: transparent;
    width: 0px;
    height: 0px;
}

QComboBox#fontCombo::down-arrow:hover {
    background: transparent;
}

QComboBox#fontCombo QAbstractItemView {
    background-color: rgba(250, 250, 250, 224);
    border: 1px solid rgba(0, 0, 0, 20);
    border-top: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    color: #333333;
    selection-background-color: rgba(0, 0, 0, 12);
    selection-color: #000000;
    padding: 4px;
    outline: none;
}

/* ── FontSizeWidget (Capsule) ── */
QFrame#fontSizeFrame {
    background-color: rgba(0, 0, 0, 10);
    border: 1px solid rgba(0, 0, 0, 15);
    border-radius: 8px;
    padding: 0px;
    min-width: 76px;
    max-width: 76px;
    min-height: 30px;
    max-height: 30px;
}

QFrame#fontSizeFrame:hover {
    background-color: rgba(0, 0, 0, 14);
    border-color: rgba(0, 0, 0, 22);
}

QFrame#fontSizeFrame[focused="true"] {
    border-color: #3B7BF5;
    background-color: rgba(0, 0, 0, 14);
}

QLineEdit#sizeEdit {
    background: transparent;
    border: none;
    color: #333333;
    font-size: 13px;
    font-weight: bold;
    padding: 0px;
    margin: 0px;
    selection-background-color: #3B7BF5;
}

QLineEdit#sizeEdit:focus {
    color: #000000;
    border: none !important;
    background: transparent !important;
    outline: none;
}

QToolButton#sizeMinusBtn, QToolButton#sizePlusBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #666666;
    font-size: 15px;
    font-weight: bold;
    padding: 0px;
    margin: 0px;
}

QToolButton#sizeMinusBtn:hover, QToolButton#sizePlusBtn:hover {
    background: rgba(0, 0, 0, 12);
    color: #000000;
}

QToolButton#sizeMinusBtn:pressed, QToolButton#sizePlusBtn:pressed {
    background: rgba(0, 0, 0, 18);
    color: #3B7BF5;
}

/* ── Glass Separator Lines ── */
QFrame#FormatSeparator {
    background: rgba(0, 0, 0, 20);
    max-width: 1px;
    min-width: 1px;
    border: none;
    margin: 3px 2px;
}
